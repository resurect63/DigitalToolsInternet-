
{
  "manifest_version": 3,
  "name": "VORTEX VPN",
  "version": "2.0.0",
  "description": "Secure proxy management powered by PKDEV.",
  "author": "PKDEV",

  "permissions": [
    "proxy",
    "storage"
  ],

  "host_permissions": [
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "VORTEX VPN",
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
